msgstr "Виконання"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 16
msgid "BigLinux performance tweaks."
msgstr "Налаштування продуктивності BigLinux."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 34
msgid "Disable Visual Effects"
msgstr "Вимкнути візуальні ефекти"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 35
msgid "Disables KWin visual effects (blur, shadows, animations). Reduces GPU load and frees memory."
msgstr ""
"Вимикає візуальні ефекти KWin (розмиття, тіні, анімації). Зменшує навантаження на графічний "
"процесор і звільняє пам'ять."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 50
msgid "CPU Maximum Performance"
msgstr "Максимальна продуктивність ЦПУ"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 51
msgid "Forces maximum processor performance mode. Ensures the processor uses maximum frequency."
msgstr ""
"Примусова максимальна продуктивність процесора. Забезпечує використання процесором максимальної "
"частоти."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 66
msgid "Disable Baloo Indexer"
msgstr "Вимкнути індексатор Baloo"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 67
msgid "Disables the Baloo file indexer. Avoids disk I/O overhead."
msgstr "Вимикає індексатор файлів Baloo. Уникає накладних витрат на введення/виведення диска."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 74
msgid "Unload S.M.A.R.T Monitor"
msgstr "Вивантажити монітор S.M.A.R.T"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 75
msgid "Disables S.M.A.R.T disk monitoring. Reduces disk I/O and CPU usage."
msgstr "Вимикає моніторинг диска S.M.A.R.T. Зменшує використання диска I/O та ЦП."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 83
msgid "Meltdown Mitigations off"
msgstr "Мітегування Meltdown вимкнено"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 84
#, python-brace-format
msgid ""
"Using mitigations=off will make your machine faster and less secure! For more information see: <a "
"href='{l}'>{l}</a>"
msgstr ""
"Використання mitigations=off зробить ваш комп'ютер швидшим, але менш безпечним! Для отримання "
"додаткової інформації дивіться: <a href='{l}'>{l}</a>"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 91
msgid "noWatchdog"
msgstr "noWatchdog"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 92
msgid ""
"Disables the hardware watchdog and TSC clocksource systems, maintaining high performance but "
"removing automatic protections against system crashes."
msgstr ""
"Вимикає апаратний контроль за допомогою таймера та системи TSC, підтримуючи високу продуктивність, "
"але усуваючи автоматичний захист від збоїв системи."
