msgstr "Beiðni í vinnslu, vinsamlegast bíða..."
msgid ""
"GRUB updated successfully!\\n"
"Restart your computer for it to take effect."
msgstr ""
"GRUB uppfært með góðum árangri!\\n"
"Endurræstu tölvuna þína til að það taki gildi."
msgid "An error occurred while updating GRUB."
msgstr "Villa kom að uppfæra GRUB."
msgid "Already enabled. No changes made."
msgstr "Nú þegar virkt. Engar breytingar gerðar."
msgid "GameMode Install"
msgstr "Leikjaskipulag Uppsetning"
msgid "Instaling GameMode, Please wait..."
msgstr "Installing GameMode, Please wait..."
msgid "GameMode installed successfully!"
msgstr "GameMode var sett upp með góðum árangri!"
msgid "Failed to install GameMode!"
msgstr "Ekki tókst að setja upp GameMode!"
