# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 15
msgid "Performance"
msgstr "Производительность"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 16
msgid "BigLinux performance tweaks."
msgstr "Настройки производительности BigLinux."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 34
msgid "Disable Visual Effects"
msgstr "Отключить визуальные эффекты"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 35
msgid "Disables KWin visual effects (blur, shadows, animations). Reduces GPU load and frees memory."
msgstr ""
"Отключает визуальные эффекты KWin (размытие, тени, анимации). Снижает нагрузку на GPU и освобождает "
"память."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 50
msgid "CPU Maximum Performance"
msgstr "Максимальная производительность ЦПУ"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 51
msgid "Forces maximum processor performance mode. Ensures the processor uses maximum frequency."
msgstr ""
"Принудительный режим максимальной производительности процессора. Обеспечивает использование "
"процессором максимальной частоты."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 66
msgid "Disable Baloo Indexer"
msgstr "Отключить индексатор Baloo"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 67
msgid "Disables the Baloo file indexer. Avoids disk I/O overhead."
msgstr "Отключает индексатор файлов Baloo. Избегает накладных расходов на ввод-вывод диска."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 74
msgid "Unload S.M.A.R.T Monitor"
msgstr "Выключить монитор S.M.A.R.T"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 75
msgid "Disables S.M.A.R.T disk monitoring. Reduces disk I/O and CPU usage."
msgstr "Отключает мониторинг диска S.M.A.R.T. Снижает использование диска и ЦП."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 83
msgid "Meltdown Mitigations off"
msgstr "Смягчения уязвимости Meltdown отключены"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 84
#, python-brace-format
msgid ""
"Using mitigations=off will make your machine faster and less secure! For more information see: <a "
"href='{l}'>{l}</a>"
msgstr ""
"Использование mitigations=off сделает вашу машину быстрее, но менее безопасной! Для получения "
"дополнительной информации смотрите: <a href='{l}'>{l}</a>"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 91
msgid "noWatchdog"
msgstr "нетНаблюдатель"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/performance_page.py, line: 92
msgid ""
"Disables the hardware watchdog and TSC clocksource systems, maintaining high performance but "
"removing automatic protections against system crashes."
msgstr ""
"Отключает аппаратный сторожевой таймер и системы источника тактовых импульсов TSC, поддерживая "
"высокую производительность, но удаляя автоматические защиты от сбоев системы."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 15
msgid "GameMode Configuration"
msgstr "Конфигурация режима игры"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 57
msgid "Restore Defaults"
msgstr "Восстановить настройки по умолчанию"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 62
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 500
msgid "Close"
msgstr "Закрыть"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 108
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 531
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 545
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 546
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 573
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 574
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 650
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 670
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 672
msgid "Error"
msgstr "Ошибка"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 123
msgid "General Settings"
msgstr "Общие настройки"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 124
msgid "Power governors and platform profiles."
msgstr "Энергетические регуляторы и профили платформ."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 132
msgid "CPU Governor: Performance"
msgstr "ЦПУ Губернатор: Производительность"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 133
msgid "Sets the CPU governor to 'performance' when GameMode is active."
msgstr "Устанавливает режим работы процессора на 'производительность', когда активен GameMode."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 142
msgid "Platform Profile: Performance"
msgstr "Профиль платформы: Производительность"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 143
msgid "Sets the platform profile to 'performance' for maximum power."
msgstr "Устанавливает профиль платформы на 'производительность' для максимальной мощности."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 153
msgid "iGPU Governor: Powersave"
msgstr "iGPU Губернатор: Энергосбережение"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 154
msgid "Sets iGPU governor to powersave when under heavy load to balance power."
msgstr ""
"Устанавливает режим управления iGPU на экономию энергии при высокой нагрузке для балансировки "
"потребления энергии."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 161
msgid "CPU Optimizations"
msgstr "Оптимизация ЦПУ"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 171
msgid "Pin Cores (P-Cores)"
msgstr "Закрепить ядра (P-ядра)"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 172
msgid ""
"Keeps game threads fixed on high-performance cores, preventing the kernel from moving the game to "
"slow cores (E-cores) mid-action."
msgstr ""
"Держит игровые потоки на высокопроизводительных ядрах, предотвращая перемещение игры на медленные "
"ядра (E-ядра) в разгаре действия."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 182
msgid "Park Efficiency Cores"
msgstr "Эффективные ядра Park"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 183
msgid "Temporarily 'turns off' efficiency cores so the OS doesn't try to use them for the game."
msgstr ""
"Временно «отключает» ядра эффективности, чтобы операционная система не пыталась использовать их для "
"игры."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 193
msgid "AMD X3D Mode: Frequency"
msgstr "Режим AMD X3D: Частота"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 194
msgid "Shifts processes to frequency CCD while gaming. For 7950X3D/9950X3D."
msgstr "Переключает процессы на частоту CCD во время игры. Для 7950X3D/9950X3D."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 203
msgid "Soft Realtime Scheduling"
msgstr "Мягкое реальное время планирования"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 204
msgid "Enables SCHED_ISO on supported kernels for reduced latency. 'auto' enables with 4+ cores."
msgstr ""
"Включает SCHED_ISO на поддерживаемых ядрах для снижения задержки. 'auto' включает при 4 и более "
"ядрах."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 213
msgid "Renice Game Process"
msgstr "Изменить приоритет процесса игры"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 214
msgid "Adjusts process priority for the game. Value 10 gives higher priority (requires gamemode group)."
msgstr ""
"Настраивает приоритет процесса для игры. Значение 10 дает более высокий приоритет (требуется группа "
"игрового режима)."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 223
msgid "I/O Priority: Maximum"
msgstr "Приоритет ввода/вывода: Максимальный"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 224
msgid "Sets I/O priority to BE/0 (highest). Improves disk access for the game."
msgstr "Устанавливает приоритет ввода-вывода на BE/0 (высший). Улучшает доступ к диску для игры."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 231
msgid "GPU Optimizations"
msgstr "Оптимизация GPU"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 240
msgid "Enable GPU Optimizations"
msgstr "Включить оптимизацию GPU"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 241
msgid "⚠️ Use at your own risk! Enables GPU overclocks and power settings."
msgstr "⚠️ Используйте на свой страх и риск! Включает разгон GPU и настройки питания."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 255
msgid "NVIDIA: Prefer Maximum Performance"
msgstr "NVIDIA: Предпочитать максимальную производительность"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 256
msgid "Sets GPUPowerMizerMode to 1 (Prefer Maximum Performance). Requires coolbits (X11 Only)."
msgstr ""
"Устанавливает GPUPowerMizerMode на 1 (Предпочитать максимальную производительность). Требует "
"coolbits (только X11)."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 264
msgid "NVIDIA: Core Clock Offset"
msgstr "NVIDIA: Смещение тактовой частоты ядра"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 265
msgid "Adds MHz offset to core clock. Set to enable +100MHz offset (X11 Only)."
msgstr ""
"Добавляет смещение МГц к тактовой частоте ядра. Установите для включения смещения +100 МГц (только "
"X11)."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 273
msgid "NVIDIA: Memory Clock Offset"
msgstr "NVIDIA: Смещение тактовой частоты памяти"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 274
msgid "Adds MHz offset to memory clock. Set to enable +200MHz offset (X11 Only)."
msgstr ""
"Добавляет смещение МГц к тактовой частоте памяти. Установите для включения смещение +200 МГц "
"(только X11)."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 280
msgid "NVIDIA Options Unavailable"
msgstr "Опции NVIDIA недоступны"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 281
msgid "NVIDIA GameMode optimizations require an X11 session. You are currently using Wayland."
msgstr "Оптимизации NVIDIA GameMode требуют сессии X11. В настоящее время вы используете Wayland."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 292
msgid "AMD: High Performance Level"
msgstr "AMD: Высокий уровень производительности"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 293
msgid "Sets power_dpm_force_performance_level to 'high'. Forces max clocks."
msgstr ""
"Устанавливает power_dpm_force_performance_level на 'высокий'. Принудительно устанавливает "
"максимальные тактовые частоты."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 300
msgid "System Settings"
msgstr "Настройки системы"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 301
msgid "Screen and system-level optimizations."
msgstr "Оптимизация на уровне экрана и системы."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 309
msgid "Inhibit Screensaver"
msgstr "Запретить заставку экрана"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 310
msgid "Prevents screensaver from activating while GameMode is active."
msgstr "Предотвращает активацию заставки, пока активен режим игры."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 319
msgid "Disable Split Lock Mitigation"
msgstr "Отключить смягчение разделения блокировки"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 320
msgid "Linux has split lock protection that can cause microsecond delays. Disabling removes this 'brake'."
msgstr ""
"В Linux есть защита от разделения блокировок, которая может вызывать задержки в микросекундах. "
"Отключение удаляет этот 'тормоз'."
