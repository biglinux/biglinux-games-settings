# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 702
msgid ""
"Combination of daemon and library that allows games to request a set of optimizations be "
"temporarily applied to the operating system and/or the game process."
msgstr ""
"Комбинация демона и библиотеки, которая позволяет играм запрашивать временное применение набора "
"оптимизаций к операционной системе и/или игровому процессу."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 719
msgid "Compositor Settings"
msgstr "Настройки композитора"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 720
msgid ""
"Configures compositor for low latency, allows tearing and disables animations. Minimizes "
"compositing overhead and reduces input lag."
msgstr ""
"Настраивает композитор для низкой задержки, позволяет разрывы изображения и отключает анимации. "
"Минимизирует накладные расходы композитинга и снижает задержку ввода."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 735
msgid "GPU Maximum Performance"
msgstr "Максимальная производительность GPU"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 736
msgid "Forces maximum GPU performance mode (NVIDIA/AMD). Ensures the graphics card uses maximum frequency."
msgstr ""
"Принудительный режим максимальной производительности GPU (NVIDIA/AMD). Обеспечивает использование "
"графической картой максимальной частоты."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 751
msgid "Stop Akonadi Server"
msgstr "Остановить сервер Akonadi"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 752
msgid "Stops the PIM data server (Kontact/Thunderbird). Reduces memory and disk overhead."
msgstr ""
"Останавливает сервер данных PIM (Kontact/Thunderbird). Снижает использование памяти и дискового "
"пространства."
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 769
msgid "GameMode Daemon"
msgstr "Демон игрового режима"
# 
# File: biglinux-games-settings/usr/share/biglinux/biglinux-games-settings/games_page_old.py, line: 770
msgid "Activates daemon that adjusts CPU, I/O, etc. Reduces latency and increases frame rate."
msgstr ""
"Активирует демон, который настраивает ЦП, ввод-вывод и т.д. Уменьшает задержку и увеличивает "
"частоту кадров."
