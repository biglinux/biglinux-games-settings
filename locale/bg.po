msgid "Example Install"
msgstr "Примерна инсталация"
msgid "Instaling Example, Please wait..."
msgstr "Инсталиране на пример, моля изчакайте..."
msgid "Example Uninstall"
msgstr "Пример деинсталиране"
msgid "Uninstaling Example, Please wait..."
msgstr "Деинсталиране на пример, моля изчакайте..."
msgid "Example installed successfully!"
msgstr "Примерът е инсталиран успешно!"
